# SwiftFormat configuration

# Indentation
--indent 4
--indentcase false
--ifdef indent
--xcodeindentation disabled

# Whitespace
--trimwhitespace always
--stripunusedargs closure-only

# Wrapping
--maxwidth 120
--wraparguments preserve
--wrapparameters preserve
--wrapcollections preserve
--wrapconditions preserve

# Braces
--allman false

# Misc
--self remove
--importgrouping alpha
--semicolons never
--commas always
--decimalgrouping 3,6
--exponentcase lowercase
--header ignore
--lifecycle
--organizetypes class,struct,enum,extension

# Modifier order — match SwiftLint's expected order (nonisolated before access control)
--modifierorder nonisolated,override,open,public,internal,fileprivate,private,final,required,convenience,static,class,lazy,weak,unowned,mutating,nonmutating,dynamic,optional

# Disabled rules — avoid fights with Xcode auto-indent and SwiftLint
--disable wrapMultilineStatementBraces
--disable blankLineAfterImports
